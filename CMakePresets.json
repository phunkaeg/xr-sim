{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}-vs",
      "cacheVariables": { "XRSIM_BUILD_TESTS": "ON" }
    },
    { "name": "x64", "inherits": "base", "architecture": "x64" },
    { "name": "x86", "inherits": "base", "architecture": "Win32" }
  ],
  "buildPresets": [
    { "name": "x64-release", "configurePreset": "x64", "configuration": "RelWithDebInfo" },
    { "name": "x86-release", "configurePreset": "x86", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "x64-release", "configurePreset": "x64", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "x86-release", "configurePreset": "x86", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } }
  ]
}
